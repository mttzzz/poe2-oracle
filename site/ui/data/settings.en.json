{
    "window": "Settings",
    "sections": ["General", "Price check", "Quick actions", "XP overlay", "Account", "Help"],
    "section": 0,
    "summary": "League, languages, scale, starting with Windows and updates",
    "version": "version {version}",
    "app_version": "0.1.4",
    "groups": [
        {
            "title": "League and language",
            "rows": [
                {
                    "label": "League",
                    "note": "Where prices are searched. Auto is the trade site's current league; your private leagues show up here once you sign in, in “Account”",
                    "control": { "type": "select", "value": "Auto · Forbidden Rites" }
                },
                {
                    "label": "Game client language",
                    "note": "The language the game copies items in. Auto tells it from the item's text",
                    "control": { "type": "segmented", "options": ["Auto", "Русский", "English"], "picked": 0 }
                },
                {
                    "label": "Interface language",
                    "note": "The app's own words; items and the trade site stay as they are. Auto follows the game client, or Windows until the game has run",
                    "control": {
                        "type": "segmented",
                        "options": ["Auto · English", "Русский", "English"],
                        "picked": 0
                    }
                }
            ]
        },
        {
            "title": "Window",
            "rows": [
                {
                    "label": "Interface scale",
                    "note": "Size of the text and controls on the price panel and in this window",
                    "control": { "type": "stepper", "value": "100%" }
                }
            ]
        },
        {
            "title": "System",
            "rows": [
                {
                    "label": "Where to show the app",
                    "note": "The icon by the clock or a button on the taskbar: a click on either opens these settings",
                    "control": {
                        "type": "segmented",
                        "options": ["In the tray", "On the taskbar", "Both"],
                        "picked": 0
                    }
                },
                {
                    "label": "Start with Windows",
                    "control": { "type": "switch", "on": false }
                }
            ]
        },
        {
            "title": "Updates",
            "rows": [
                {
                    "label": "Update automatically",
                    "note": "Stays connected to oracle.pushka.biz: new versions and game data install by themselves, the app restarting once none of its windows is open",
                    "control": { "type": "switch", "on": true }
                },
                {
                    "label": "Version {version} · game data 2026092601",
                    "note": ["Connected to oracle.pushka.biz", "You have the latest version"],
                    "control": { "type": "button", "label": "Check now", "kind": "secondary" }
                }
            ]
        }
    ]
}
