        <h2 id="rust-crates">Rust crates</h2>
        <p>
            The crates PoE2 Oracle is built from, as cargo-about found them in the dependency
            graph, grouped by the license text each one ships with. Licenses used:
        </p>
        <ul>
            {{#each overview}}
            <li><a href="#{{id}}">{{name}}</a></li>
            {{/each}}
        </ul>

        {{#each licenses}}
        {{#unless (and (eq (len used_by) 1) (not used_by.[0].crate.source))}}
        <section class="license">
            <h3{{#if first_of_kind}} id="{{id}}"{{/if}}>{{name}}</h3>
            <ul class="used-by">
                {{#each used_by}}
                {{#if crate.source}}
                <li>{{#if crate.repository}}<a href="{{crate.repository}}">{{crate.name}} {{crate.version}}</a>{{else}}{{crate.name}} {{crate.version}}{{/if}}</li>
                {{/if}}
                {{/each}}
            </ul>
            <pre>{{text}}</pre>
        </section>
        {{/unless}}
        {{/each}}
